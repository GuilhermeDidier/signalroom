# Copy to api/.env (gitignored) or export. See src/config.ts for every option.
PORT=4000
DATABASE_URL=postgres://signalroom:signalroom@localhost:5434/signalroom
# DATABASE_SEARCH_PATH=signalroom,public   # only if the role has no search_path set
REDIS_URL=redis://localhost:6379
AI_URL=http://localhost:8000
INTERNAL_TOKEN=change-me-shared-with-ai
JWT_SECRET=change-me-at-least-16-chars
DEMO_MODE=true
DEMO_PASSWORD=change-me-demo-password
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
